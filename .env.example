# Copy to .env.local (setup does this for you). Never commit real values.
# Validated at startup by src/lib/env.ts — add new keys there too.

# Public canonical URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The shop's WhatsApp number that receives orders: digits only, with country
# code (e.g. 919876543210). Leave blank and "Order on WhatsApp" lets the
# customer choose who to send the order to.
NEXT_PUBLIC_WHATSAPP_NUMBER=
